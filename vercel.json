{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "installCommand": "corepack yarn install --immutable",
  "buildCommand": "corepack yarn build",
  "crons": [
    {
      "path": "/api/cron/github-stats",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/analytics",
      "schedule": "0 17 * * *"
    }
  ]
}
