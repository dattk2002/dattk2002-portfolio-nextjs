# Public URL used for canonical links, sitemap, robots, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres. Use the pooled URL at runtime and the direct URL for migrations.
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Blog administration. Only this immutable GitHub account ID can access the editor.
ADMIN_GITHUB_ACCOUNT_ID=20634808
NEON_AUTH_BASE_URL=https://your-auth-endpoint
NEON_AUTH_COOKIE_SECRET=generate-at-least-32-random-characters

# Vercel Blob upload credential for blog cover and inline images.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Contact form recipient.
CONTACT_TO_EMAIL=kimdat0705@gmail.com

# Resend credentials. Verify the sender domain before production deployment.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Portfolio <contact@dattk.dev>

# Optional contact-form rate limiting. The form remains configurable without
# committing secrets; production validation will require these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
