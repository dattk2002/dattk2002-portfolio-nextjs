# Public URL used for canonical links, sitemap, robots, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form recipient.
CONTACT_TO_EMAIL=kimdat0705@gmail.com

# Resend credentials. Verify the sender domain before production deployment.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional contact-form rate limiting. The form remains configurable without
# committing secrets; production validation will require these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
